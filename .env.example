# Database (docker-compose defaults)
DATABASE_URL="postgresql://bagshop:bagshop@localhost:5432/bagandshop?schema=public"

# Neon / hosted Postgres: use sslmode=verify-full (not require) to avoid pg SSL deprecation warnings
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=verify-full"

# NextAuth — generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Razorpay — https://dashboard.razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Resend — https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bag & Shop <orders@bagandshop.com>"

# Algolia (optional — falls back to DB search)
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
ALGOLIA_INDEX_NAME="products"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob — admin image/video uploads (auto-set when you add Blob storage on Vercel)
# Local dev: omit to save files under public/uploads/
BLOB_READ_WRITE_TOKEN=""

# Cron — Bearer token for /api/cron/* (see README)
# Off by default so Vercel deploy succeeds; copy vercel.crons.json → vercel.json when enabling
CRON_JOBS_ENABLED="false"
CRON_SECRET="generate-a-random-secret"
# Admin alerts (low stock, expired coupons)
CRON_ADMIN_EMAIL="admin@yourdomain.com"
# Optional tuning (defaults in src/lib/cron-config.ts)
# CRON_ABANDONED_FIRST_HOURS=1
# CRON_ABANDONED_SECOND_HOURS=24
# CRON_ABANDONED_THIRD_HOURS=72
# CRON_REVIEW_DAYS=7
# CRON_PAYMENT_PENDING_HOURS=2
# CRON_LOW_STOCK_THRESHOLD=5
# CRON_BATCH_SIZE=20
